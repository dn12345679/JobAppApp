{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Job Tracker",
  "version": "1.5.1",
  "identifier": "com.dylan.jobtracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Job Tracker",
        "width": 1440,
        "height": 920,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0b1120"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMTkwOTA1NDRDNjU5MUQKUldRZFdjWkVCUWtaSHo1VDh3SFdETzNHVjdmVzNRYVNHN0VNMWd0ZGg1anc5RENaaE9OUmpveGoK",
      "endpoints": [
        "https://github.com/dn12345679/JobAppApp/releases/latest/download/latest.json"
      ]
    }
  }
}
